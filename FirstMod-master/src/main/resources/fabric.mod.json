			"mymod.MyMod"
		],
		"fabric-datagen": [
			"mymod.MyModDataGenerator"
		]
	},
	"mixins": [
		"mymod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*"
	}
