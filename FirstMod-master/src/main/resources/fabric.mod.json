{
	"schemaVersion": 1,
	"id": "mymod",
	"version": "${version}",
	"name": "MyMod",
	"description": "This is my first mod in Minecraft!",
	"authors": [
		"p1ayer"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/mymod/icon.png",
